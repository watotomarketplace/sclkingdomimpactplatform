generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PROGRAM_ADMIN  // retained for back-compat; treated as SUPER_ADMIN by roles.ts
  FACILITATOR
  GROUP_LEADER   // Addendum 3: new role between Participant and Facilitator
  PARTICIPANT
}

enum MilestoneType {
  ONBOARDING
  MILESTONE_1
  MILESTONE_2
  MILESTONE_3
  MILESTONE_4
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  LATE
  AT_RISK
}

enum MeetingFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum InitiativeType {
  NEW_BUSINESS       // "I am starting a new business or organisation"
  WORKPLACE_SOLUTION // "I am building a solution within my current workplace"
}

enum SphereOfInfluence {
  BUSINESS
  EDUCATION
  GOVERNMENT
  CHURCH
  MEDIA
  HEALTH
  ARTS
  FAMILY
}

enum GateDecision {
  APPROVED
  REVISION_REQUESTED
  REDIRECTED
}

enum ScorecardStatus {
  ON_TRACK
  NEEDS_ATTENTION
  ESCALATE
}

enum PhaseStatus {
  LOCKED
  AVAILABLE
  DRAFT
  SUBMITTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ParticipantCategory {
  ENTREPRENEUR
  INTRAPRENEUR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          Role      @default(PARTICIPANT)
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  covenantSigned   Boolean   @default(false)
  covenantSignedAt DateTime?
  covenantData     Json?

  readinessComplete Boolean @default(false)

  calendlyLink String?

  // Addendum 3: profile fields (Watoto pre-created accounts)
  phone             String?
  campus            String?
  sphereOfInfluence SphereOfInfluence?

  // Addendum 3: onboarding state replaces covenant flow
  onboardingComplete   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  mviBriefData         Json?     // 12-field MVI Brief stored here on first login

  // Addendum 3: initiative type captured at Milestone 1 (not signup)
  initiativeType InitiativeType?

  coachingSessions             CoachingSession[]
  milestoneSubmissions         MilestoneSubmission[]
  reviewedMilestones           MilestoneSubmission[] @relation("MilestoneReviewer")
  authoredMeetingSummaries     GroupMeetingSummary[]

  participantProfile    ParticipantProfile?
  podMembership         PodMember?
  submissions           Submission[]
  scorecards            Scorecard[]
  journals              JournalEntry[]
  sentCoachingNotes     CoachingNote[]  @relation("NoteAuthor")
  receivedCoachingNotes CoachingNote[]  @relation("NoteRecipient")
  gateReviews           GateReview[]    @relation("ReviewedBy")
  invitationsSent       Invitation[]    @relation("InvitedBy")
  invitation            Invitation?     @relation("InvitedUser")
  notifications         Notification[]
  auditLogs             AuditLog[]
  managedCohorts        CohortAdmin[]
  facilitatedPods       Pod[]           @relation("PodFacilitator")
  systemSettingsUpdates SystemSettings[] @relation("SettingsUpdatedBy")
  readinessAssessments  ReadinessAssessment[]
  problemEntries        ProblemEntry[]

  @@map("users")
}

model ParticipantProfile {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId     String?
  cohort       Cohort?              @relation(fields: [cohortId], references: [id])
  currentMonth Int                  @default(1)
  category     ParticipantCategory?
  attendanceConfirmed Boolean       @default(false)
  createdAt    DateTime             @default(now())

  @@map("participant_profiles")
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ParticipantProfile[]
  pods         Pod[]
  admins       CohortAdmin[]

  @@map("cohorts")
}

model CohortAdmin {
  cohortId String
  userId   String
  cohort   Cohort @relation(fields: [cohortId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@id([cohortId, userId])
  @@map("cohort_admins")
}

model Pod {
  id            String   @id @default(cuid())
  name          String
  cohortId      String
  cohort        Cohort   @relation(fields: [cohortId], references: [id])
  facilitatorId String?
  facilitator   User?    @relation("PodFacilitator", fields: [facilitatorId], references: [id])
  createdAt     DateTime @default(now())

  members          PodMember[]
  meetingSummaries GroupMeetingSummary[]

  @@map("pods")
}

model PodMember {
  userId   String   @unique
  podId    String
  user     User     @relation(fields: [userId], references: [id])
  pod      Pod      @relation(fields: [podId], references: [id])
  joinedAt DateTime @default(now())

  // Addendum 3: Group Leader flag, set by admin after Day 3
  isLeader Boolean  @default(false)

  @@id([userId, podId])
  @@map("pod_members")
}

model Submission {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  month       Int
  phase       String
  status      PhaseStatus @default(AVAILABLE)
  formData    Json        @default("{}")
  draftData   Json?
  submittedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  gateReview GateReview?

  @@unique([userId, month, phase])
  @@map("submissions")
}

model GateReview {
  id           String        @id @default(cuid())
  submissionId String        @unique
  submission   Submission    @relation(fields: [submissionId], references: [id])
  reviewerId   String?
  reviewer     User?         @relation("ReviewedBy", fields: [reviewerId], references: [id])
  decision     GateDecision?
  feedback     String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@map("gate_reviews")
}

model Scorecard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  month  Int

  problemClarity         ScorecardStatus @default(ON_TRACK)
  problemClarityEvidence String?
  problemClarityAction   String?

  researchEffort         ScorecardStatus @default(ON_TRACK)
  researchEffortEvidence String?
  researchEffortAction   String?

  executionDiscipline         ScorecardStatus @default(ON_TRACK)
  executionDisciplineEvidence String?
  executionDisciplineAction   String?

  mvpProgress         ScorecardStatus @default(ON_TRACK)
  mvpProgressEvidence String?
  mvpProgressAction   String?

  kingdomAlignment         ScorecardStatus @default(ON_TRACK)
  kingdomAlignmentEvidence String?
  kingdomAlignmentAction   String?

  peerEngagement         ScorecardStatus @default(ON_TRACK)
  peerEngagementEvidence String?
  peerEngagementAction   String?

  facilitatorNotes String?
  submittedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month])
  @@map("scorecards")
}

model JournalEntry {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  month     Int
  isPrivate Boolean @default(false)

  prompt1   String?
  prompt2   String?
  prompt3   String?
  prompt4   String?
  prompt5   String?
  freeNotes String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, month])
  @@map("journal_entries")
}

model CoachingNote {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation("NoteAuthor", fields: [authorId], references: [id])
  recipientId String
  recipient   User     @relation("NoteRecipient", fields: [recipientId], references: [id])
  content     String
  createdAt   DateTime @default(now())

  @@map("coaching_notes")
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  name        String
  role        Role
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  userId      String?          @unique
  user        User?            @relation("InvitedUser", fields: [userId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@map("invitations")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

model SystemSettings {
  id                String   @id @default("singleton")
  platformName      String   @default("SCL Kingdom Impact Work Platform")
  supportEmail      String   @default("support@scl-platform.org")
  sessionTimeoutMin Int      @default(60)
  invitationExpiryH Int      @default(72)
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("system_settings")
}

model ReadinessAssessment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionNumber Int
  currentAnswer  String    @default("")
  actionToTake   String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, questionNumber])
  @@map("readiness_assessments")
}

model ProblemEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  observation String   // What did you observe?
  sphere      String   // Where did you see it?
  affected    String?  // Who is affected?
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("problem_entries")
}

model CoachingSession {
  id            String    @id @default(cuid())
  participantId String
  participant   User      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  month         Int
  sessionDate   DateTime
  notes         String?
  calendlyEventId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("coaching_sessions")
}

// Addendum 3: New milestone-based submission model (replaces month/phase Submission for new flow)
model MilestoneSubmission {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneType MilestoneType
  status        MilestoneStatus @default(IN_PROGRESS)
  formData      Json            @default("{}")
  fileUrls      Json?           // array of uploaded file references
  submittedAt   DateTime?
  deadline      DateTime?
  // Facilitator review
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?           @relation("MilestoneReviewer", fields: [reviewedById], references: [id])
  reviewNotes   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, milestoneType])
  @@map("milestone_submissions")
}

// Addendum 3: Group Leader monthly meeting summary
model GroupMeetingSummary {
  id          String        @id @default(cuid())
  podId       String
  pod         Pod           @relation(fields: [podId], references: [id], onDelete: Cascade)
  authorId    String        // group leader who submitted
  author      User          @relation(fields: [authorId], references: [id])
  meetingDate DateTime
  format      MeetingFormat
  attendeeIds Json          // array of user IDs who attended
  summary     String
  concerns    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("group_meeting_summaries")
}
